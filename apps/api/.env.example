# Copia este archivo a .env y llena los valores. Nunca subas .env a GitHub.
PORT=3000
NODE_ENV=development

# Supabase (gratis) o el Postgres de docker-compose
DATABASE_URL="postgresql://finflow:finflow@localhost:5432/finflow?schema=public"

# Genera con: openssl rand -base64 48
JWT_SECRET=""
# Clave AES-256 para cifrar campos sensibles. Genera con: openssl rand -base64 32
DATA_ENCRYPTION_KEY=""

# Google AI Studio (capa gratuita). Sin clave, el chat usa solo el intérprete local.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
AI_DAILY_LIMIT=30

# Reenvío de correos del banco (Cloudflare Email Routing + Worker)
INBOUND_EMAIL_DOMAIN="example.com"
INBOUND_EMAIL_SECRET=""

THROTTLE_LIMIT=100

# NestJS Observe: los escribe `npx @nestjs/observe link`
OBSERVE_APP_KEY=""
OBSERVE_APP_SECRET=""
